rules_version = '2';

// Report photos: each user may upload images under their own uid folder.
// Cloud Functions read them with the Admin SDK (bypasses rules) for
// verification; other clients cannot browse strangers' photos.
service firebase.storage {
  match /b/{bucket}/o {
    match /reports/{uid}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
